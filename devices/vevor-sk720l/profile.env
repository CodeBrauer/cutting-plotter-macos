# Machine profile for the VEVOR SK-720L (the SK-870L shares this firmware).
# Sourced by ./plot. Copy this file to add another machine -- see CONTRIBUTING.md.

# Human-readable name, shown in messages.
DEVICE_NAME="VEVOR SK-720L"

# CUPS queue name created by ./setup.sh.
CUPS_QUEUE="VEVOR_SK720L"

# Substring used to find the machine in `lpinfo -v`. The SK-720L reports itself
# as a WCH USB device using the USB printer class.
USB_URI_MATCH="wch.cn"

# Device section name inside device.toml.
VPYPE_DEVICE="sk720l"

# 1016 dpi. Verified: 4000 units moved a measured 100 mm on both axes.
UNITS_PER_MM=40

# Cutting width: 630 mm x 40 units/mm. Jobs wider than this are rejected
# before anything is sent.
MAX_CROSSFEED_UNITS=25200

# Default rotation. 90 puts the design's width across the roll.
# Use 270 if you want the result readable while sitting in front of the machine.
DEFAULT_ROTATE=90
